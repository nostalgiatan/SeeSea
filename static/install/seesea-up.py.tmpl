#!/usr/bin/env python3
"""
SeeSea Updater Script
Module Name: seesea-up.py
Responsibility: Handle installation, update, and uninstallation of SeeSea
Expected Implementation: Download and execute platform-specific installation scripts
Implemented Features: Version checking, platform detection, script download and execution
Usage Dependencies: Python 3.10-3.12, standard library only
Main Interfaces: Command-line interface with install/update/uninstall commands
Note: This script is generated during release process, do not edit manually
"""

import sys
import os
import platform
import json
import tempfile
import urllib.request
import importlib.util
from typing import Dict, List

# Template placeholder for available platforms
available_platforms: Dict[str, List[str]] = {{ available_platforms }}

VERSION = "{{ version }}"


def check_python_version():
    """Check if Python version is compatible (3.10-3.12)"""
    major, minor, _ = sys.version_info
    if not (major == 3 and 10 <= minor <= 12):
        print(f"Error: Python 3.10-3.12 is required, but you have {major}.{minor}")
        sys.exit(1)


def get_current_platform():
    """Get current platform and architecture"""
    # Get platform
    plat = sys.platform
    if plat.startswith('win'):
        platform_name = 'windows'
    elif plat.startswith('linux'):
        platform_name = 'linux'
    elif plat.startswith('darwin'):
        platform_name = 'macos'
    else:
        print(f"Error: Unsupported platform {plat}")
        sys.exit(1)
    
    # Get architecture
    arch = platform.machine()
    if arch in ['x86_64', 'amd64']:
        arch = 'amd64'
    elif arch in ['arm64', 'aarch64']:
        arch = 'arm64'
    elif arch in ['armv7', 'armv7l', 'armhf']:
        arch = 'armv7'
    else:
        print(f"Error: Unsupported architecture {arch}")
        sys.exit(1)
    
    return platform_name, arch


def get_python_version_string():
    """Get Python version as string without dots (e.g., 3.10 -> 310)"""
    major, minor, _ = sys.version_info
    return f"{major}{minor}"


def main():
    """Main function"""
    print(f"SeeSea Updater v{VERSION}")
    
    # Check Python version
    check_python_version()
    
    # Parse command
    if len(sys.argv) < 2:
        print("Usage: seesea-up.py [install|update|uninstall]")
        sys.exit(1)
    
    command = sys.argv[1].lower()
    if command not in ['install', 'update', 'uninstall']:
        print("Error: Invalid command. Use install, update, or uninstall.")
        sys.exit(1)
    
    # Get platform info
    platform_name, arch = get_current_platform()
    py_version = get_python_version_string()
    
    print(f"Current platform: {platform_name}-{arch}")
    print(f"Python version: {sys.version.split()[0]}")
    
    # Check if platform is supported
    if platform_name not in available_platforms or arch not in available_platforms[platform_name]:
        print(f"Error: Platform {platform_name}-{arch} is not supported.")
        sys.exit(1)
    
    # Build target filename
    target_file = f"SeeSea-{platform_name}-{arch}-py{py_version}.py"
    download_url = f"https://gh-proxy.org/https://github.com/nostalgiatan/SeeSea/releases/latest/download/{target_file}"
    
    print(f"Downloading {target_file}...")
    
    # Download the file to temporary directory
    with tempfile.TemporaryDirectory() as tmpdir:
        local_path = os.path.join(tmpdir, target_file)
        
        try:
            urllib.request.urlretrieve(download_url, local_path)
            print(f"Downloaded to {local_path}")
            
            # Import and execute the downloaded module
            spec = importlib.util.spec_from_file_location("platform_script", local_path)
            if spec and spec.loader:
                platform_module = importlib.util.module_from_spec(spec)
                sys.modules["platform_script"] = platform_module
                spec.loader.exec_module(platform_module)
                
                # Call the main function with the command
                if hasattr(platform_module, "main"):
                    platform_module.main(command)
                else:
                    print("Error: Downloaded script has no main function")
                    sys.exit(1)
            else:
                print("Error: Could not load downloaded script")
                sys.exit(1)
                
        except Exception as e:
            print(f"Error: {e}")
            sys.exit(1)


if __name__ == "__main__":
    main()
