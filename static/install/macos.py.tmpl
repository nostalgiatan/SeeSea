def run_command(cmd: str, cwd: Optional[str] = None, shell: bool = True, show_progress: bool = True) -> subprocess.CompletedProcess[str]:
    """Run a command with user-friendly progress display"""
    if show_progress:
        print(f"\n🔧 Running: {cmd[:80]}..." if len(cmd) > 80 else f"🔧 Running: {cmd}")
    
    # Don't capture output to show real-time pip progress
    result = subprocess.run(cmd, cwd=cwd, shell=shell, executable='/bin/bash', text=True)
    if result.returncode != 0:
        print(f"❌ Command failed with exit code {result.returncode}")
        sys.exit(1)
    if show_progress:
        print(f"✅ Done")
    return result


def ask_use_venv() -> None:
