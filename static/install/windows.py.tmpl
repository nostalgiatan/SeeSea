def main(command: str) -> None:
    """Main installation entry point"""
    global INSTALL_DIR
    
    print("\n" + "="*60)
    print("🌊 SeeSea Windows Installer")
    print("="*60)
    print(f"Command: {command}")
    print(f"Version: {metadata['seesea_version']}")
    print("="*60)
    
    if command == 'install':
        # Ask about installation location first
        INSTALL_DIR = ask_install_location()
        
        # Ask about virtual environment
        ask_use_venv()
        
        print("\n[Step 1/4] Setting up environment...")
        setup_environment()
        print("✅ Environment ready")
        
        print("\n[Step 2/4] Installing dependencies...")
        install_dependencies()
        
        print("\n[Step 3/4] Installing SeeSea...")
        install_seesea()
        
        # Ask about Pro features
        print("\n[Step 4/4] Optional Pro features...")
        pro_method = ask_install_pro()
        if pro_method:
            install_pro_features(pro_method)
        
        print("\n" + "="*60)
        print("✨ Installation Complete! ✨")
        print("="*60)
        
        if USE_VENV:
            print("\n� Installation Location:")
            print(f"  {INSTALL_DIR}")
            print("\n�📚 Quick Start:")
            print(f"  {os.path.join(VENV_DIR, 'Scripts', 'seesea.exe')} --help")
            print("\n💡 To use 'seesea' command anywhere, add to PATH:")
            print(f"  {os.path.join(VENV_DIR, 'Scripts')}")
            print("\n  Or create an alias in PowerShell profile:")
            print(f'  Set-Alias seesea "{os.path.join(VENV_DIR, "Scripts", "seesea.exe")}"')
        else:
            print("\n📚 Quick Start:")
            print("  seesea --help")
        
        print("\n🔧 Configuration:")
        print(f"  Config file: %USERPROFILE%\\.seesea\\config.toml")
        print("\n📖 Documentation:")
        print("  https://github.com/zwtesttt/SeeSea")
        print("="*60 + "\n")
        
    elif command == 'update':
        print("\n🔄 Updating SeeSea...")
        update_seesea()
        print("\n✅ Update completed successfully!")
        
    elif command == 'uninstall':
        print("\n🗑️  Uninstalling SeeSea...")
        uninstall_seesea()
        print("\n✅ Uninstall completed successfully!")
        
    else:
        print(f"\n❌ Error: Unknown command '{command}'")
        print("\nUsage: python windows.py [install|update|uninstall]")
        print("\nCommands:")
        print("  install    - Install SeeSea")
        print("  update     - Update SeeSea to latest version")
        print("  uninstall  - Remove SeeSea from system")
        sys.exit(1)


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("\n" + "="*60)
        print("🌊 SeeSea Windows Installer")
        print("="*60)
        print("\nUsage: python windows.py [install|update|uninstall]")
        print("\nCommands:")
        print("  install    - Install SeeSea")
        print("  update     - Update SeeSea to latest version")
        print("  uninstall  - Remove SeeSea from system")
        print("="*60 + "\n")
        sys.exit(1)
    
    main(sys.argv[1])
