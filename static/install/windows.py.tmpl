#!/usr/bin/env python3
"""
SeeSea Windows Installer Script
Module Name: windows.py
Responsibility: Handle SeeSea installation on Windows platform
Expected Implementation: Extract and install SeeSea packages with dependencies
Implemented Features: zstandard decompression, whl reconstruction, dependency installation
Usage Dependencies: Python 3.10-3.12, zstandard
Main Interfaces: Command-line interface with install/update/uninstall commands
Note: This script is generated during release process, do not edit manually
"""

import sys
import os
import tempfile
import shutil
import subprocess
import io
from pathlib import Path
from typing import Dict, List, Optional, Any, BinaryIO
import base64

# Template metadata dictionary (will be replaced by build script)
metadata: Dict[str, str] = {}

# Base64-encoded compressed data (will be replaced by build script)
bin_seesea_b64: str = ''
bin_seesea_core_b64: str = ''

# Decode base64 to bytes at runtime
bin_seesea: bytes = base64.b64decode(bin_seesea_b64) if bin_seesea_b64 else b''
bin_seesea_core: bytes = base64.b64decode(bin_seesea_core_b64) if bin_seesea_core_b64 else b''

# Template requirements list (will be replaced by build script)
requirements: List[str] = []

# Global variables
# Default installation directory
DEFAULT_INSTALL_DIR: str = os.path.join(os.environ.get('LOCALAPPDATA', os.path.expanduser('~\\AppData\\Local')), 'SeeSea')
INSTALL_DIR: str = DEFAULT_INSTALL_DIR
VENV_DIR: str = ""
USE_VENV: Optional[bool] = None  # Will be set by user choice


def ask_install_location() -> str:
    """Ask user where to install SeeSea"""
    print("\n" + "="*60)
    print("📁 Installation Location")
    print("="*60)
    print("Choose installation directory:")
    print(f"  [1] Default - {DEFAULT_INSTALL_DIR}")
    print(f"  [2] D: drive - D:\\SeeSea")
    print(f"  [3] Custom location")
    print("="*60)
    
    while True:
        choice = input("\nYour choice (1/2/3): ").strip()
        if choice == '1' or choice == '':
            return DEFAULT_INSTALL_DIR
        elif choice == '2':
            return "D:\\SeeSea"
        elif choice == '3':
            custom_path = input("Enter custom installation path: ").strip()
            if custom_path:
                # Expand environment variables
                custom_path = os.path.expandvars(custom_path)
                return custom_path
            else:
                print("❌ Invalid path. Please try again.")
        else:
            print("❌ Invalid input. Please enter 1, 2, or 3.")


def run_command(cmd: str, cwd: Optional[str] = None, shell: bool = True, show_progress: bool = True) -> subprocess.CompletedProcess[str]:
    """Run a command with user-friendly progress display"""
    if show_progress:
        print(f"\n📦 {cmd.split()[0].capitalize()} {cmd.split()[1] if len(cmd.split()) > 1 else ''}...")
        
    # Use Popen to show real-time output instead of capturing all at once
    result = subprocess.run(cmd, cwd=cwd, shell=shell, capture_output=False, text=True)
    if result.returncode != 0:
        print(f"\n❌ Error executing command: {cmd}")
        sys.exit(1)
    
    if show_progress:
        print(f"✅ Done")
    return result


def ask_use_venv() -> None:
    """Ask user whether to use virtual environment"""
    global USE_VENV
    print("\n" + "="*60)
    print("🤔 Virtual Environment Setup")
    print("="*60)
    print(f"Installation directory: {INSTALL_DIR}")
    print("\nDo you want to use a virtual environment?")
    print("  [Y] Yes - Install in isolated environment (Recommended)")
    print("  [N] No  - Install globally (Requires admin privileges)")
    print("="*60)
    
    while True:
        response = input("\nYour choice (Y/n): ").strip().lower()
        if response in ['', 'y', 'yes']:
            USE_VENV = True
            print("✅ Will use virtual environment")
            break
        elif response in ['n', 'no']:
            USE_VENV = False
            print("✅ Will install globally")
            break
        else:
            print("❌ Invalid input. Please enter Y or N.")


def setup_environment() -> None:
    """Setup installation environment"""
    global VENV_DIR
    VENV_DIR = os.path.join(INSTALL_DIR, 'venv')
    
    if USE_VENV:
        # Create install directory
        print(f"\n📁 Installing to: {INSTALL_DIR}")
        os.makedirs(INSTALL_DIR, exist_ok=True)
        
        # Create virtual environment
        print("\n📦 Creating virtual environment...")
        # Use sys.executable to ensure we use the current Python interpreter
        # Quote paths in case they contain spaces
        run_command(f'"{sys.executable}" -m venv "{VENV_DIR}"', show_progress=False)
        print("✅ Virtual environment created")


def get_pip_prefix() -> str:
    """Return pip command prefix based on venv choice"""
    if USE_VENV:
        # Windows activation uses .bat file - quote the path in case it contains spaces
        activate_script = os.path.join(VENV_DIR, 'Scripts', 'activate.bat')
        return f'"{activate_script}" && '
    return ""


def install_dependencies() -> None:
    """Install dependencies"""
    print("\n" + "="*60)
    print("📦 Installing Dependencies...")
    print("="*60)
    
    # Install zstandard first for decompression
    print("\n[1/5] Installing zstandard for decompression...")
    run_command(f"{get_pip_prefix()}pip install zstandard", show_progress=False)
    print("✅ zstandard installed")
    
    # Now import zstandard after installation
    global zstandard
    import zstandard
    
    # Install requirements
    if requirements:
        print(f"\n[2/5] Installing Python packages ({len(requirements)} packages)...")
        run_command(f"{get_pip_prefix()}pip install {' '.join(requirements)}", show_progress=False)
        print("✅ Python packages installed")
    
    # Special handling for playwright
    print("\n[3/5] Installing playwright...")
    run_command(f"{get_pip_prefix()}pip install playwright", show_progress=False)
    print("✅ playwright installed")
    
    print("\n[4/5] Installing Chromium browser...")
    run_command(f"{get_pip_prefix()}playwright install chromium", show_progress=False)
    print("✅ Chromium browser installed")
    
    # Special handling for crawl4ai - only run setup, installation is already in requirements
    print("\n[5/5] Setting up crawl4ai...")
    run_command(f"{get_pip_prefix()}crawl4ai-setup", show_progress=False)
    print("✅ crawl4ai configured")


def decompress_whl(compressed_data: BinaryIO, output_path: str) -> None:
    """Decompress zstandard compressed whl file"""
    dctx = zstandard.ZstdDecompressor()
    with open(output_path, 'wb') as f:
        dctx.copy_stream(compressed_data, f)


def install_seesea() -> None:
    """Install SeeSea packages"""
    print("\n" + "="*60)
    print("📦 Installing SeeSea...")
    print("="*60)
    
    # Create temporary directory
    work_dir = INSTALL_DIR if USE_VENV else tempfile.mkdtemp()
    if not USE_VENV:
        print(f"\n[1/5] Working in temporary directory: {work_dir}")
    else:
        print(f"\n[1/5] Working in installation directory: {work_dir}")
    
    try:
        # Decompress whl files using BytesIO streams
        seesea_path = os.path.join(work_dir, metadata['seesea_filename'])
        seesea_core_path = os.path.join(work_dir, metadata['seesea_core_filename'])
        
        # Create BytesIO streams from compressed data
        seesea_stream = io.BytesIO(bin_seesea)
        seesea_core_stream = io.BytesIO(bin_seesea_core)
        
        # Decompress whl files
        print("\n[2/5] Decompressing seesea-core package...")
        decompress_whl(seesea_core_stream, seesea_core_path)
        print("✅ seesea-core decompressed")
        
        print("\n[3/5] Decompressing seesea package...")
        decompress_whl(seesea_stream, seesea_path)
        print("✅ seesea decompressed")
        
        # Install whl files
        print("\n[4/5] Installing seesea-core...")
        run_command(f"{get_pip_prefix()}pip install {seesea_core_path}", show_progress=False)
        print("✅ seesea-core installed")
        
        print("\n[5/5] Installing seesea...")
        run_command(f"{get_pip_prefix()}pip install {seesea_path}", show_progress=False)
        print("✅ seesea installed")
    finally:
        # Clean up temp directory if not using venv
        if not USE_VENV and work_dir != INSTALL_DIR:
            shutil.rmtree(work_dir, ignore_errors=True)
    
    print("\n" + "="*60)
    print("🎉 SeeSea installed successfully!")
    print("="*60)


def uninstall_seesea() -> None:
    """Uninstall SeeSea"""
    run_command(f"{get_pip_prefix()}pip uninstall -y seesea seesea-core")


def update_seesea() -> None:
    """Update SeeSea"""
    # Uninstall old version
    uninstall_seesea()
    # Install new version
    install_dependencies()
    install_seesea()


def ask_install_pro() -> Optional[str]:
    """Ask user if they want to install Pro features"""
    print("\n" + "="*60)
    print("🌟 Optional Pro Features")
    print("="*60)
    print("SeeSea Pro provides advanced features like:")
    print("  • Advanced AI capabilities")
    print("  • Enhanced search algorithms")
    print("  • Premium support")
    print("\nWould you like to configure Pro features?")
    print("  [1] Configure now")
