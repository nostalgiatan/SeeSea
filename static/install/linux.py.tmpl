INSTALL_DIR = "/etc/seesea"
VENV_DIR = os.path.join(INSTALL_DIR, "venv")
BIN_DIR = "/usr/local/bin"
USE_VENV = None  # Will be set by user choice


def run_command(cmd, cwd=None, shell=True, show_progress=True):
    """Run a command with user-friendly progress display"""
    if show_progress:
        print(f"\n📦 {cmd.split()[0].capitalize()} {cmd.split()[1] if len(cmd.split()) > 1 else ''}...")
        
    # Use Popen to show real-time output instead of capturing all at once
    result = subprocess.run(cmd, cwd=cwd, shell=shell, executable='/bin/bash', capture_output=False, text=True)
    if result.returncode != 0:
        print(f"\n❌ Error executing command: {cmd}")
        sys.exit(1)
    
    if show_progress:
        print(f"✅ Done")
    return result


def ask_use_venv():
    """Ask user whether to use virtual environment"""
    global USE_VENV
    print("\n" + "="*60)
    print("🤔 Virtual Environment Setup")
    print("="*60)
    print("Do you want to use a virtual environment?")
    print("  [Y] Yes - Install in isolated environment (Recommended)")
    print("  [N] No  - Install globally (Requires admin privileges)")
    print("="*60)
    
    while True:
        response = input("\nYour choice (Y/n): ").strip().lower()
        if response in ['', 'y', 'yes']:
            USE_VENV = True
            print("✅ Will use virtual environment")
            break
        elif response in ['n', 'no']:
            USE_VENV = False
            print("✅ Will install globally")
            break
        else:
            print("❌ Invalid input. Please enter Y or N.")


def setup_environment():
    """Setup installation environment"""
    if USE_VENV:
        # Create install directory
        run_command(f"mkdir -p {INSTALL_DIR}", show_progress=False)
        
        # Create virtual environment
        print("\n📦 Creating virtual environment...")
        run_command(f"python3 -m venv {VENV_DIR}", show_progress=False)
        print("✅ Virtual environment created")


def get_pip_prefix():
    """Return pip command prefix based on venv choice"""
    if USE_VENV:
        return f"source {VENV_DIR}/bin/activate && "
    return ""


def install_dependencies():
    """Install dependencies"""
    print("\n" + "="*60)
    print("🔧 Installing dependencies...")
    print("="*60)
    
    # Install zstandard first for decompression
    print("\n[1/5] Installing zstandard for decompression...")
    run_command(f"{get_pip_prefix()} pip install zstandard")
    
    # Now import zstandard after installation
    global zstandard
    import zstandard
    
    # Install requirements
    if requirements:
        print(f"\n[2/5] Installing Python packages ({len(requirements)} packages)...")
        run_command(f"{get_pip_prefix()} pip install {' '.join(requirements)}")
    
    # Special handling for playwright
    print("\n[3/5] Installing Playwright...")
    run_command(f"{get_pip_prefix()} pip install playwright")
    
    print("\n[4/5] Installing Chromium browser (this may take a while)...")
    run_command(f"{get_pip_prefix()} playwright install chromium")
    
    print("\n[5/5] Installing system dependencies for Playwright...")
    run_command(f"{get_pip_prefix()} playwright install-deps")
    print("✅ System dependencies installed")
    
    # Special handling for crawl4ai - only run setup, installation is already in requirements
    print("\n[Extra] Setting up Crawl4AI...")
    run_command(f"{get_pip_prefix()} crawl4ai-setup")


