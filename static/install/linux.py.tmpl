    run_command(f"{activate_venv()} pip install {seesea_path}")
    
    # Create symlink to /usr/local/bin
    seesea_venv_path = os.path.join(VENV_DIR, "bin", "seesea")
    seesea_link_path = os.path.join(BIN_DIR, "seesea")
    
    # Remove existing link if it exists
    if os.path.exists(seesea_link_path):
        run_command(f"rm {seesea_link_path}")
    
    # Create new link
    run_command(f"ln -s {seesea_venv_path} {seesea_link_path}")


def uninstall_seesea():
    """Uninstall SeeSea"""
    # Remove symlink
    seesea_link_path = os.path.join(BIN_DIR, "seesea")
    if os.path.exists(seesea_link_path):
        run_command(f"rm {seesea_link_path}")
    
    # Remove install directory
    if os.path.exists(INSTALL_DIR):
        run_command(f"rm -rf {INSTALL_DIR}")


def update_seesea():
    """Update SeeSea"""
    # For update, we just reinstall
    uninstall_seesea()
    setup_environment()
    install_dependencies()
    install_seesea()


def main(command):
    """Main function"""
    print(f"SeeSea Linux Installer - {command}")
    
    if command == 'install':
        setup_environment()
        install_dependencies()
        install_seesea()
    elif command == 'update':
        update_seesea()
    elif command == 'uninstall':
        uninstall_seesea()
    else:
        print(f"Error: Unknown command {command}")
        sys.exit(1)
    
    print("Operation completed successfully!")


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: linux.py [install|update|uninstall]")
        sys.exit(1)
    main(sys.argv[1])
