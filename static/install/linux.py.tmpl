    else:  # compile
        print("\n[1/2] Installing llama-cpp-python (compiling locally, this may take 10-20 minutes)...")
        run_command(f"{get_pip_prefix()} pip install llama-cpp-python")
    
    print("\n[2/2] Downloading Qwen3-Embedding-0.6B model...")
    print("📥 This will download approximately 1.5GB of model data...")
    # The actual model download will be handled by SeeSea on first run
    print("✅ Pro features installation complete!")
    print("💡 Model will be downloaded automatically on first use")
    
    print("\n" + "="*60)
    print("✨ Pro Features Ready!")
    print("="*60)


def decompress_whl(compressed_data: BinaryIO, output_path: str) -> None:
    """Decompress zstandard compressed whl file"""
    dctx = zstandard.ZstdDecompressor()
    with open(output_path, 'wb') as f:
        dctx.copy_stream(compressed_data, f)


def install_seesea() -> None:
    """Install SeeSea packages"""
    print("\n" + "="*60)
    print("📦 Installing SeeSea...")
    print("="*60)
    
    # Change to install directory
    work_dir = INSTALL_DIR if USE_VENV else tempfile.mkdtemp()
    if not USE_VENV:
        print(f"📁 Working directory: {work_dir}")
    os.chdir(work_dir)
    
    # Decompress whl files using BytesIO streams
    seesea_path = os.path.join(work_dir, metadata['seesea_filename'])
    seesea_core_path = os.path.join(work_dir, metadata['seesea_core_filename'])
    
    # Create BytesIO streams from compressed data
    seesea_stream = io.BytesIO(bin_seesea)
    seesea_core_stream = io.BytesIO(bin_seesea_core)
    
    # Decompress whl files
    print("\n[1/4] Decompressing seesea-core package...")
    decompress_whl(seesea_core_stream, seesea_core_path)
    print("✅ seesea-core decompressed")
    
    print("\n[2/4] Decompressing seesea package...")
    decompress_whl(seesea_stream, seesea_path)
    print("✅ seesea decompressed")
    
    # Install whl files
    print("\n[3/4] Installing seesea-core...")
    run_command(f"{get_pip_prefix()} pip install {seesea_core_path}")
    
    print("\n[4/4] Installing seesea...")
    run_command(f"{get_pip_prefix()} pip install {seesea_path}")
    
    # Create symlink to /usr/local/bin (only for venv mode)
    if USE_VENV:
        print("\n[Final] Creating command-line symlink...")
        seesea_venv_path = os.path.join(VENV_DIR, "bin", "seesea")
        seesea_link_path = os.path.join(BIN_DIR, "seesea")
        
        # Remove existing link if it exists
        if os.path.exists(seesea_link_path):
            run_command(f"rm {seesea_link_path}", show_progress=False)
        
        # Create new link
        run_command(f"ln -s {seesea_venv_path} {seesea_link_path}", show_progress=False)
        print(f"✅ Command 'seesea' is now available globally")
    else:
        # Clean up temp directory
        if work_dir != INSTALL_DIR:
            shutil.rmtree(work_dir)
        print(f"✅ SeeSea installed globally, use 'seesea' command")
    
    print("\n" + "="*60)
    print("🎉 SeeSea installed successfully!")
    print("="*60)


def uninstall_seesea() -> None:
    """Uninstall SeeSea"""
    # Remove symlink
    seesea_link_path = os.path.join(BIN_DIR, "seesea")
    if os.path.exists(seesea_link_path):
        run_command(f"rm {seesea_link_path}")
    
    # Remove install directory
    if os.path.exists(INSTALL_DIR):
        run_command(f"rm -rf {INSTALL_DIR}")


def update_seesea() -> None:
    """Update SeeSea"""
    # For update, we just reinstall
    uninstall_seesea()
    setup_environment()
    install_dependencies()
    install_seesea()


def main(command: str) -> None:
    """Main function"""
    print("\n" + "="*60)
    print("🌊 SeeSea Linux Installer")
    print("="*60)
    print(f"Command: {command}")
    print(f"Version: {metadata['seesea_version']}")
    print("="*60)
    
    if command == 'install':
        # Ask about virtual environment first
        ask_use_venv()
        
        print("\n[Step 1/4] Setting up environment...")
        setup_environment()
        print("✅ Environment ready")
        
        print("\n[Step 2/4] Installing dependencies...")
        install_dependencies()
        
        print("\n[Step 3/4] Installing SeeSea...")
        install_seesea()
        
        # Ask about Pro features
        print("\n[Step 4/4] Optional Pro features...")
        pro_method = ask_install_pro()
        if pro_method:
            install_pro_features(pro_method)
        
        print("\n" + "="*60)
        print("✨ Installation Complete! ✨")
        print("="*60)
        print("\n📚 Quick Start:")
        print("  seesea --help")
        print("\n🔧 Configuration:")
        print(f"  Config file: ~/.config/seesea/config.toml")
        print("\n📖 Documentation:")
        print("  https://github.com/zwtesttt/SeeSea")
        print("="*60 + "\n")
        
    elif command == 'update':
        print("\n🔄 Updating SeeSea...")
        update_seesea()
        print("\n✅ Update completed successfully!")
        
    elif command == 'uninstall':
        print("\n🗑️  Uninstalling SeeSea...")
        uninstall_seesea()
        print("\n✅ Uninstall completed successfully!")
        
    else:
        print(f"\n❌ Error: Unknown command '{command}'")
        print("\nUsage: python linux.py [install|update|uninstall]")
        print("\nCommands:")
        print("  install    - Install SeeSea")
        print("  update     - Update SeeSea to latest version")
        print("  uninstall  - Remove SeeSea from system")
        sys.exit(1)


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("\n" + "="*60)
        print("🌊 SeeSea Linux Installer")
        print("="*60)
        print("\nUsage: python linux.py [install|update|uninstall]")
        print("\nCommands:")
        print("  install    - Install SeeSea")
        print("  update     - Update SeeSea to latest version")
        print("  uninstall  - Remove SeeSea from system")
        print("="*60 + "\n")
