        print("="*60 + "\n")
        
    elif command == 'update':
        print("\n🔄 Updating SeeSea...")
        update_seesea()
        print("\n✅ Update completed successfully!")
        
    elif command == 'uninstall':
        print("\n🗑️  Uninstalling SeeSea...")
        uninstall_seesea()
        print("\n✅ Uninstall completed successfully!")
        
    else:
        print(f"\n❌ Error: Unknown command '{command}'")
        print("\nUsage: linux.py [install|update|uninstall]")
        sys.exit(1)


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: linux.py [install|update|uninstall]")
        sys.exit(1)
    main(sys.argv[1])
