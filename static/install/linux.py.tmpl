def run_command(cmd, cwd=None, shell=True, show_progress=True):
    """Run a command with user-friendly progress display"""
    if show_progress:
        print(f"\n📦 {cmd.split()[0].capitalize()} {cmd.split()[1] if len(cmd.split()) > 1 else ''}...")
        
    # Use Popen to show real-time output instead of capturing all at once
    result = subprocess.run(cmd, cwd=cwd, shell=shell, capture_output=False, text=True)
    if result.returncode != 0:
        print(f"\n❌ Error executing command: {cmd}")
        sys.exit(1)
    
    if show_progress:
        print(f"✅ Done")
    return result


def setup_environment():
    """Setup installation environment"""
    # Create install directory
    run_command(f"mkdir -p {INSTALL_DIR}")
    
    # Create virtual environment
    run_command(f"python3 -m venv {VENV_DIR}")


def activate_venv():
    """Return commands with virtual environment activated"""
    return f"source {VENV_DIR}/bin/activate && "


def install_dependencies():
    """Install dependencies"""
    # Install zstandard first for decompression
    run_command(f"{activate_venv()} pip install zstandard")
    
    # Install requirements
    if requirements:
        run_command(f"{activate_venv()} pip install {' '.join(requirements)}")
    
    # Special handling for playwright
    run_command(f"{activate_venv()} pip install playwright")
    run_command(f"{activate_venv()} playwright install chromium")
    run_command(f"{activate_venv()} playwright install-deps")
    
    # Special handling for crawl4ai - only run setup, installation is already in requirements
    run_command(f"{activate_venv()} crawl4ai-setup")


def install_seesea():
    """Install SeeSea packages"""
    # Change to install directory
    os.chdir(INSTALL_DIR)
    
    # Decompress whl files using BytesIO streams
    seesea_path = os.path.join(INSTALL_DIR, metadata['seesea_filename'])
    seesea_core_path = os.path.join(INSTALL_DIR, metadata['seesea_core_filename'])
    
    # Create BytesIO streams from compressed data
    seesea_stream = io.BytesIO(bin_seesea)
    seesea_core_stream = io.BytesIO(bin_seesea_core)
    
