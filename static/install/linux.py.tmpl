def install_pro_features(method: str) -> None:
    """Install Pro features including LLM support"""
    print("\n" + "="*60)
    print("🚀 Installing Pro Features...")
    print("="*60)
    
    if method == 'prebuilt':
        print("\n[1/2] Installing llama-cpp-python (pre-built)...")
